{
	"$schema": "https://v2-10-12.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".eve/**", ".output/**", ".vercel/output/**"]
		},
		"check-types": {
			"dependsOn": ["topo", "^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AGENT_BRIDGE_SECRET",
				"AI_GATEWAY_API_KEY",
				"BLOB_READ_WRITE_TOKEN",
				"CARTESIA_API_KEY",
				"CONTEXT_DEV_API_KEY",
				"DATABASE_URL",
				"DEEPGRAM_API_KEY",
				"ELEVENLABS_API_KEY",
				"GITHUB_TOKEN",
				"RAPIDAPI_KEY",
				"TAVILY_API_KEY",
				"EXA_API_KEY",
				"BRAVE_API_KEY",
				"FIRECRAWL_API_KEY",
				"GOOGLE_API_KEY",
				"OLLAMA_BASE_URL",
				"OLLAMA_MODEL",
				"LMSTUDIO_BASE_URL",
				"LMSTUDIO_MODEL",
				"LLAMA_CPP_BASE_URL",
				"KOBOLD_BASE_URL",
				"KOBOLD_MODEL",
				"OPENCODE_API_URL",
				"OPENCODE_API_KEY",
				"OPENROUTER_API_KEY",
				"OPENROUTER_MODEL",
				"REPLICATE_API_TOKEN",
				"TELNYX_API_KEY",
				"TELNYX_CALLER_ID",
				"TWILIO_ACCOUNT_SID",
				"TWILIO_AUTH_TOKEN",
				"TWILIO_CALLER_ID",
				"VERIFY_RECHECK_DAYS"
			]
		},
		"test": {
			"dependsOn": ["topo", "^build"],
			"passThroughEnv": ["DATABASE_URL"]
		}
	}
}
